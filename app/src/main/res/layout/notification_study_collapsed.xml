<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/notif_collapsed_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_notif_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingTop="12dp"
    android:paddingEnd="14dp"
    android:paddingBottom="12dp">

    <!-- App Logo Box -->
    <ImageView
        android:id="@+id/notif_app_icon"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:src="@drawable/ic_app_notification_logo"
        android:contentDescription="@string/app_name" />

    <!-- Text content -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- App Name + Timestamp -->
        <TextView
            android:id="@+id/notif_header_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Peace FlashCard • now 🔔"
            android:textColor="#5856D6"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- Title -->
        <TextView
            android:id="@+id/notif_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="🔥 Giờ học tới rồi!"
            android:textColor="#1F2440"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- Message Body -->
        <TextView
            android:id="@+id/notif_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="Dành 7 phút học flashcard để giữ vững streak nhé!"
            android:textColor="#4B5270"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Mascot Penguin Image -->
    <ImageView
        android:id="@+id/notif_mascot_image"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:scaleType="centerInside"
        android:src="@drawable/img_mascot_penguin_1787286222548"
        android:contentDescription="Mascot" />

</LinearLayout>
