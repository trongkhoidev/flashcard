<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="14dp">

    <!-- TOP HEADER: TITLE LEFT, STREAK CORNER BADGE RIGHT (chạm = mở app) -->
    <RelativeLayout
        android:id="@+id/layout_widget_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/tv_widget_header"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:text="📖 Từ đang học"
            android:textColor="#4338CA"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- STREAK CORNER BADGE -->
        <LinearLayout
            android:id="@+id/layout_widget_streak"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/widget_streak_pill"
            android:clickable="true"
            android:focusable="true"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp">

            <TextView
                android:id="@+id/tv_widget_streak"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔥 0 ngày"
                android:textColor="#EA580C"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
    </RelativeLayout>

    <!-- MIDDLE: FLIP CARD (chạm = lật mặt trước/sau) -->
    <ViewFlipper
        android:id="@+id/widget_flipper"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clickable="true"
        android:focusable="true"
        android:inAnimation="@anim/widget_fade_in"
        android:outAnimation="@anim/widget_fade_out">

        <!-- ===== MẶT TRƯỚC: TỪ + PHIÊN ÂM + VÍ DỤ ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingVertical="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_widget_front_word"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Resilient"
                    android:textColor="#1E1B4B"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_widget_pos"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/widget_tag_pill"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"
                    android:text="adj"
                    android:textColor="#4338CA"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_widget_phonetic"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="/rɪˈzɪl.jənt/"
                android:textColor="#64748B"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tv_widget_example"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:text="💡 He is resilient in facing challenges."
                android:textColor="#475569"
                android:textSize="11sp"
                android:textStyle="italic" />

            <TextView
                android:id="@+id/tv_widget_flip_hint_front"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="👆 Chạm để xem nghĩa"
                android:textColor="#94A3B8"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- ===== MẶT SAU: NGHĨA + DỊCH VÍ DỤ ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingVertical="6dp">

            <TextView
                android:id="@+id/tv_widget_back_hint_word"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="🇬🇧 Resilient • adj"
                android:textColor="#94A3B8"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tv_widget_meaning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:text="Kiên cường, phục hồi nhanh"
                android:textColor="#1E293B"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_widget_back_translation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:text="💡 Anh ấy kiên cường đối mặt thử thách."
                android:textColor="#475569"
                android:textSize="11sp"
                android:textStyle="italic" />

            <TextView
                android:id="@+id/tv_widget_flip_hint_back"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="👆 Chạm để lật lại"
                android:textColor="#94A3B8"
                android:textSize="10sp" />
        </LinearLayout>
    </ViewFlipper>

    <!-- BOTTOM ROW (chạm = mở app): CẦN ÔN + DECK | NÚT TỪ KHÁC -->
    <RelativeLayout
        android:id="@+id/layout_widget_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp">

        <TextView
            android:id="@+id/tv_widget_deck_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:ellipsize="start"
            android:maxLines="1"
            android:text="⏰ Cần ôn: 0 từ"
            android:textColor="#64748B"
            android:textSize="10sp" />

        <LinearLayout
            android:id="@+id/btn_widget_refresh"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/widget_btn_refresh"
            android:clickable="true"
            android:focusable="true"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp"
            android:paddingVertical="7dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔄 Từ khác"
                android:textColor="#4338CA"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </RelativeLayout>

</LinearLayout>
