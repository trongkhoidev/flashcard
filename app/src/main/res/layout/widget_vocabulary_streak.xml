<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="14dp">

    <!-- TOP HEADER: TITLE LEFT, STREAK CORNER BADGE RIGHT -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_widget_header"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📖 Từ đang học"
                android:textColor="#4338CA"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- STREAK CORNER BADGE -->
        <LinearLayout
            android:id="@+id/layout_widget_streak"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/widget_streak_pill"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp">

            <TextView
                android:id="@+id/tv_widget_streak"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔥 7 ngày"
                android:textColor="#EA580C"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
    </RelativeLayout>

    <!-- MIDDLE: VOCABULARY WORD CONTENT -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingVertical="6dp">

        <!-- FRONT WORD & PART OF SPEECH -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_widget_front_word"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Resilient"
                android:textColor="#1E1B4B"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_widget_pos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_tag_pill"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:text="adj"
                android:textColor="#4338CA"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- PHONETIC -->
        <TextView
            android:id="@+id/tv_widget_phonetic"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="/rɪˈzɪl.jənt/"
            android:textColor="#64748B"
            android:textSize="11sp" />

        <!-- VIETNAMESE MEANING -->
        <TextView
            android:id="@+id/tv_widget_meaning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="Kiên cường, có khả năng phục hồi nhanh"
            android:textColor="#1E293B"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- EXAMPLE SENTENCE -->
        <TextView
            android:id="@+id/tv_widget_example"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="💡 He is resilient in facing challenges."
            android:textColor="#475569"
            android:textSize="11sp"
            android:textStyle="italic" />
    </LinearLayout>

    <!-- BOTTOM ROW: REFRESH BUTTON & QUICK ACTION -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp">

        <TextView
            android:id="@+id/tv_widget_deck_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:text="🇬🇧 Tiếng Anh Nâng Cao"
            android:textColor="#64748B"
            android:textSize="10sp" />

        <LinearLayout
            android:id="@+id/btn_widget_refresh"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/widget_btn_refresh"
            android:clickable="true"
            android:focusable="true"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp"
            android:paddingVertical="7dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔄 Từ khác"
                android:textColor="#4338CA"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </RelativeLayout>

</LinearLayout>
